modules = ["python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Car Tracker Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "flask_app"

[[workflows.workflow]]
name = "Car Tracker Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pip install flask beautifulsoup4 requests apscheduler && python app.py"
waitForPort = 5000

[[workflows.workflow]]
name = "flask_app"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv add flask beautifulsoup4 requests apscheduler"

[deployment]
run = ["sh", "-c", "python -m pip install flask beautifulsoup4 requests apscheduler && python app.py"]

[[ports]]
localPort = 5000
externalPort = 80
